# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR DEPIN & BANDWIDTH MONETIZATION STACK
# Contabo VPS (Ubuntu - 4 vCPU, 8 GB RAM, 100 GB SSD, Static Datacenter IPv4)
#
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Populate your credentials and API keys below.
# 3. Secure file permissions:
#    chmod 600 .env
# 4. Never commit your populated .env to public version control!
# ==============================================================================

# Enable extra profiles only if you populate PacketShare or Repocket credentials below.
# Leave blank to run only the active, verified services.
# Example: COMPOSE_PROFILES=packetshare,repocket
COMPOSE_PROFILES=

# ------------------------------------------------------------------------------
# 1. TraffMonetizer
# Dashboard: https://app.traffmonetizer.com/
# Copy your application token from the main dashboard.
# ------------------------------------------------------------------------------
TRAFFMONETIZER_TOKEN=your_traffmonetizer_token_here
TRAFFMONETIZER_DEVICE_NAME=contabo-vps

# ------------------------------------------------------------------------------
# 2. EarnFM
# Dashboard: https://app.earn.fm/
# Obtain your API key / UUID token under Account Settings.
# ------------------------------------------------------------------------------
EARNFM_TOKEN=your_earnfm_api_token_here

# ------------------------------------------------------------------------------
# 3. ProxyRack Peer (Datacenter / VPS Friendly)
# Dashboard: https://peer.proxyrack.com/
# Copy your API key from the dashboard profile.
# ------------------------------------------------------------------------------
PROXYRACK_API_KEY=your_proxyrack_api_key_here

# ------------------------------------------------------------------------------
# 4. BitPing
# Dashboard: https://app.bitping.com/
# Account email and password.
# If you have Two-Factor Authentication (2FA) enabled, enter the code in BITPING_MFA
# for the initial startup, then clear it once authenticated.
# ------------------------------------------------------------------------------
BITPING_EMAIL=your_bitping_email@example.com
BITPING_PASSWORD=your_bitping_password_here
BITPING_MFA=

# ------------------------------------------------------------------------------
# 5. Titan Network (DePIN Edge Node)
# Console: https://test1.titannet.io/ or https://titannet.io/
# Get your Identity Code / Hash under "Node Management" -> "Binding".
#
# STORAGE ALLOCATION:
# Default is 55GB to maximize daily point generation on a 100GB SSD,
# while safely leaving ~35GB free for the OS, Docker, and logs.
# ------------------------------------------------------------------------------
TITAN_IDENTITY_CODE=your_titan_identity_code_here
TITAN_STORAGE_SIZE=55GB
TITAN_BIND_URL=https://api-test1.container1.titannet.io/api/v2/device/binding

# ------------------------------------------------------------------------------
# 6. PacketShare (Optional profile: packetshare)
# Dashboard: https://www.packetshare.io/
# ------------------------------------------------------------------------------
PACKETSHARE_EMAIL=
PACKETSHARE_PASSWORD=

# ------------------------------------------------------------------------------
# 7. Repocket (Optional profile: repocket)
# Dashboard: https://app.repocket.com/
# ------------------------------------------------------------------------------
REPOCKET_EMAIL=
REPOCKET_API_KEY=
